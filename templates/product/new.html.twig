{% extends 'layouts/admin.html.twig' %}

{% block page_title %}Nouveau produit{% endblock %}

{% block content %}
<div class="max-w-3xl">
    <div class="bg-white rounded-lg shadow p-6">
        <div class="mb-6">
            <h3 class="text-lg font-semibold text-gray-900">Créer un nouveau produit</h3>
            <p class="text-sm text-gray-600 mt-1">Étape {{ flow.currentStepNumber }} sur {{ flow.maxSteps }}</p>
            
            <div class="mt-4">
                <div class="flex items-center">
                    {% for stepNumber in 1..flow.maxSteps %}
                        <div class="flex-1 flex items-center">
                            {% if stepNumber == flow.currentStepNumber %}
                                <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-blue-600 text-white text-sm font-medium">
                                    {{ stepNumber }}
                                </div>
                            {% elseif stepNumber < flow.currentStepNumber %}
                                <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-green-600 text-white text-sm">
                                    ✓
                                </div>
                            {% else %}
                                <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-gray-200 text-gray-600 text-sm font-medium">
                                    {{ stepNumber }}
                                </div>
                            {% endif %}
                            {% if stepNumber < flow.maxSteps %}
                                <div class="flex-1 h-1 {{ stepNumber < flow.currentStepNumber ? 'bg-green-600' : 'bg-gray-200' }} mx-2"></div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {{ form_start(form) }}

        {{ form_errors(form) }}

        <div class="space-y-6 mb-6">
            {% if flow.currentStepNumber == 1 %}
                <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-4">
                    <p class="text-sm text-blue-700">Sélectionnez le type de produit que vous souhaitez créer</p>
                </div>
            {% elseif flow.getCurrentStepLabel() == 'Récapitulatif' %}
                <div class="bg-gray-50 rounded-lg p-4 space-y-3">
                    <h4 class="font-semibold text-gray-900">Récapitulatif du produit</h4>
                    
                    {% set formData = flow.formData %}
                    
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-gray-600">Type</p>
                            <p class="font-medium">{{ formData.type == 'physical' ? 'Produit physique' : 'Produit numérique' }}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Prix</p>
                            <p class="font-medium">{{ formData.price }} €</p>
                        </div>
                    </div>
                    
                    <div>
                        <p class="text-sm text-gray-600">Nom</p>
                        <p class="font-medium">{{ formData.name }}</p>
                    </div>
                    
                    {% if formData.description %}
                    <div>
                        <p class="text-sm text-gray-600">Description</p>
                        <p class="text-sm">{{ formData.description }}</p>
                    </div>
                    {% endif %}
                    
                    {% if formData.type == 'physical' %}
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <p class="text-sm text-gray-600">Poids</p>
                                <p class="font-medium">{{ formData.weight ?? 'N/A' }} kg</p>
                            </div>
                            <div>
                                <p class="text-sm text-gray-600">Stock</p>
                                <p class="font-medium">{{ formData.stock ?? 'N/A' }}</p>
                            </div>
                        </div>
                    {% else %}
                        <div>
                            <p class="text-sm text-gray-600">Clé de licence</p>
                            <p class="font-medium font-mono text-sm">{{ formData.licenseKey ?? 'N/A' }}</p>
                        </div>
                    {% endif %}
                </div>
            {% else %}
                {{ form_widget(form) }}
            {% endif %}
        </div>

        <div class="flex justify-between pt-4 border-t border-gray-200">
            {% if flow.currentStepNumber > 1 %}
                <button type="submit" name="flow_productFlow_transition[back]" formnovalidate 
                        class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg transition-colors">
                    ← Précédent
                </button>
            {% else %}
                <a href="{{ path('app_product_index') }}" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg transition-colors">
                    Annuler
                </a>
            {% endif %}

            {% if flow.currentStepNumber < flow.maxSteps %}
                <button type="submit" 
                        class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors">
                    Suivant →
                </button>
            {% else %}
                <button type="submit" 
                        class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition-colors">
                    Enregistrer le produit
                </button>
            {% endif %}
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
